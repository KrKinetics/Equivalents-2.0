SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Preview enables server nutrition automatically (VERCEL_ENV=preview).
# Force ON locally: COACH_FEATURE_SERVER_NUTRITION=1
# Force OFF even on Preview: COACH_FEATURE_SERVER_NUTRITION=0
# COACH_FEATURE_SERVER_NUTRITION=

# Admin scripts only (never inject into the browser /config.js):
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only intake invitation mail (never inject into /config.js):
# RESEND_API_KEY=
# COACH_MAIL_FROM=
# COACH_MAIL_MODE=disabled
# Production sends require both COACH_MAIL_MODE=production and VERCEL_ENV=production.
# COACH_MAIL_TEST_RECIPIENTS=

