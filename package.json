{
  "name": "equiv-alim-pdf",
  "version": "1.0.0",
  "description": "KR Kinetics food equivalents guide + nutrition data source of truth",
  "main": "generate.js",
  "scripts": {
    "generate": "node generate.js",
    "generate:mobile": "node generate.js --mobile",
    "generate:landscape": "node generate.js --landscape",
    "data:bootstrap": "node scripts/bootstrap-from-legacy.mjs",
    "data:import": "node scripts/import-from-legacy.mjs",
    "data:audit": "node scripts/audit-food-equivalents.mjs",
    "data:apply": "node scripts/apply-food-equivalents.mjs",
    "data:approve": "node scripts/approve-dataset.mjs",
    "schema:generate": "node scripts/generate-schema-validator.mjs",
    "schema:check": "node scripts/check-schema-validator.mjs",
    "data:report:classification": "node scripts/report-classification.mjs",
    "data:report:prep": "node scripts/report-not-applicable-candidates.mjs",
    "test": "npm run schema:check && node --test tests/nutrition-hardening.test.mjs",
    "test:nutrition": "node --test tests/nutrition-hardening.test.mjs",
    "test:browser": "node --test tests/food-data-review.browser.test.mjs",
    "test:all": "npm run schema:check && node --test tests/nutrition-hardening.test.mjs tests/food-data-review.browser.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^25.1.0"
  }
}
