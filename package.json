{
  "name": "equiv-alim-pdf",
  "version": "1.0.0",
  "description": "KR Kinetics food equivalents guide + nutrition data source of truth",
  "main": "generate.js",
  "scripts": {
    "generate": "node generate.js",
    "generate:mobile": "node generate.js --mobile",
    "generate:landscape": "node generate.js --landscape",
    "data:bootstrap": "node scripts/bootstrap-from-legacy.mjs",
    "data:import": "node scripts/import-from-legacy.mjs",
    "data:audit": "node scripts/audit-food-equivalents.mjs",
    "data:apply": "node scripts/apply-food-equivalents.mjs",
    "data:approve": "node scripts/approve-dataset.mjs",
    "schema:generate": "node scripts/generate-schema-validator.mjs",
    "schema:check": "node scripts/check-schema-validator.mjs",
    "pilot:check": "node scripts/check-nutrition-pilot-scope.mjs",
    "pilot:report": "node scripts/generate-nutrition-pilot-report.mjs",
    "sources:cnf:sync": "node scripts/sync-cnf-2026.mjs",
    "sources:manufacturer:evidence": "node scripts/write-fairlife-evidence.mjs",
    "nutrition:batch:validate": "node scripts/nutrition-batch-validate.mjs",
    "nutrition:batch:preview": "node scripts/nutrition-batch-preview.mjs",
    "nutrition:batch:apply": "node scripts/nutrition-batch-apply.mjs",
    "data:report:classification": "node scripts/report-classification.mjs",
    "data:report:prep": "node scripts/report-not-applicable-candidates.mjs",
    "test": "npm run schema:check && npm run pilot:check && node --test tests/nutrition-hardening.test.mjs tests/nutrition-batch-engine.test.mjs",
    "test:nutrition": "node --test tests/nutrition-hardening.test.mjs tests/nutrition-batch-engine.test.mjs",
    "test:browser": "node --test tests/food-data-review.browser.test.mjs",
    "test:all": "npm run schema:check && npm run pilot:check && node --test tests/nutrition-hardening.test.mjs tests/nutrition-batch-engine.test.mjs tests/food-data-review.browser.test.mjs"
  },
