{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run coach:vercel:build",
  "outputDirectory": "dist/coach-vercel",
  "functions": {
    "api/coach-food-search.js": {
      "includeFiles": "coach-calculator/coach-data.json"
    },
    "api/coach-food-detail.js": {
      "includeFiles": "coach-calculator/coach-data.json"
    },
    "api/coach-calc-equivalences.js": {
      "includeFiles": "coach-calculator/coach-data.json"
    },
    "api/coach-calc-energy.js": {
      "includeFiles": "src/lib/**"
    },
    "api/coach-calc-macros.js": {
      "includeFiles": "src/lib/**"
    },
    "api/coach-calc-portions.js": {
      "includeFiles": "{src/lib/**,src/coach/**}"
    },
    "api/coach-generate-pdf.js": {
      "includeFiles": "{coach-calculator/assets/logo-*,src/coach/server/pdf/embedded-logos.mjs}",
      "maxDuration": 60,
      "memory": 1536
    }
  },
  "rewrites": [
    {
      "source": "/workspace",
      "destination": "/workspace/index.html"
    }
  ],
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/login.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/dashboard.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/workspace/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://esm.sh; connect-src 'self' https://*.supabase.co https://esm.sh; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
