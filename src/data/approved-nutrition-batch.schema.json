{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krkinetics.local/schemas/approved-nutrition-batch.schema.json",
  "title": "KR Kinetics Approved Nutrition Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "title",
    "status",
    "approvedBy",
    "approvedAt",
    "scope",
    "foods"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "batchId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved_for_implementation",
        "applied",
        "archived"
      ]
    },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "minLength": 8 },
    "purpose": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingFoodCount",
        "newFoodCount",
        "expectedFinalFoodCount",
        "pilotFoodCount",
        "protectedFoodCount",
        "allowedFoodIds"
      ],
      "properties": {
        "existingFoodCount": { "type": "integer", "minimum": 0 },
        "newFoodCount": { "type": "integer", "minimum": 0 },
        "expectedFinalFoodCount": { "type": "integer", "minimum": 1 },
        "pilotFoodCount": { "type": "integer", "minimum": 1 },
        "protectedFoodCount": { "type": "integer", "minimum": 0 },
        "allowedFoodIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "sourcePolicy": { "type": "object" },
    "roundingPolicy": { "type": "object" },
    "genericFoodNutrientsRequired": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "foods": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/batchFood" }
    }
  },
  "$defs": {
    "lockedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fr", "en", "preparationState"],
      "properties": {
        "fr": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "preparationState": { "type": "string", "minLength": 1 },
        "exclusions": { "type": "array", "items": { "type": "string" } },
        "brand": { "type": ["string", "null"] },
        "marketNote": { "type": "string" }
      }
    },
    "canonicalPortion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labelFr", "labelEn", "amount", "unit"],
      "properties": {
        "labelFr": { "type": "string", "minLength": 1 },
        "labelEn": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "grams": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayCategory",
        "calculationGroup",
        "exchangeProfileId",
        "classificationStatus"
      ],
      "properties": {
        "displayCategory": { "type": "string", "minLength": 1 },
        "calculationGroup": { "type": "string", "minLength": 1 },
        "exchangeProfileId": { "type": ["string", "null"] },
        "classificationStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        }
      }
    },
    "sourcePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "matchKeywordsEn", "mustContainConcepts", "mustNotContainConcepts"],
      "properties": {
        "adapter": { "type": "string", "const": "cnf_2026" },
        "matchKeywordsEn": { "type": "array", "items": { "type": "string" } },
        "mustContainConcepts": { "type": "array", "items": { "type": "string" } },
        "mustNotContainConcepts": { "type": "array", "items": { "type": "string" } },
        "ambiguityRule": { "type": "string" }
      }
    },
    "manufacturerLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "url",
        "accessedAt",
        "labelServing",
        "labelNutrients",
        "derivedUnroundedPer100Ml",
        "storedPer100Ml"
      ],
      "properties": {
        "sourceType": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "accessedAt": { "type": "string", "minLength": 8 },
        "labelServing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "unit"],
          "properties": {
            "amount": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string", "minLength": 1 }
          }
        },
        "labelNutrients": { "type": "object" },
        "derivedUnroundedPer100Ml": { "type": "object" },
        "storedPer100Ml": { "type": "object" }
      }
    },
    "batchFood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "id", "lockedIdentity", "canonicalPortion", "classification"],
      "properties": {
        "operation": { "type": "string", "enum": ["update", "add"] },
        "id": { "type": "string", "minLength": 1 },
        "lockedIdentity": { "$ref": "#/$defs/lockedIdentity" },
        "canonicalPortion": { "$ref": "#/$defs/canonicalPortion" },
        "portionDecision": { "type": "string" },
        "sourcePlan": { "$ref": "#/$defs/sourcePlan" },
        "manufacturerLabel": { "$ref": "#/$defs/manufacturerLabel" },
        "classification": { "$ref": "#/$defs/classification" }
      },
      "oneOf": [
        { "required": ["sourcePlan"] },
        { "required": ["manufacturerLabel"] }
      ]
    }
  }
}
