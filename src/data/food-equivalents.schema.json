{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krkinetics.local/schemas/food-equivalents.schema.json",
  "title": "KR Kinetics Food Equivalents Dataset",
  "type": "object",
  "required": ["meta", "foods"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "totalFoods"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "importedAt": { "type": ["string", "null"] },
        "totalFoods": { "type": "integer", "minimum": 0 },
        "importPolicy": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "sourceFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bootstrapWarning": { "type": "string" },
        "lastAppliedAt": { "type": ["string", "null"] },
        "baseDataHash": { "type": ["string", "null"], "minLength": 1 },
        "exportDataHash": { "type": ["string", "null"], "minLength": 1 },
        "lastAppliedFromBaseDataHash": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "lastAppliedExportDataHash": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "exportedAt": { "type": ["string", "null"] },
        "exportedBy": { "type": ["string", "null"] },
        "sourceDatasetVersion": { "type": ["string", "null"] },
        "allowStaleReason": { "type": ["string", "null"] }
      }
    },
    "foods": {
      "type": "array",
      "items": { "$ref": "#/$defs/food" }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "isoDateTime": {
      "type": "string",
      "minLength": 10
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://.+"
    },
    "doi": {
      "type": "string",
      "pattern": "^(10\\.\\d{4,9}/\\S+|https?://(dx\\.)?doi\\.org/10\\.\\d{4,9}/\\S+)$"
    },
    "nutrient": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "historyEntry": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "anyOf": [
        { "required": ["timestamp"] },
        { "required": ["at"] }
      ],
      "properties": {
        "timestamp": { "type": "string" },
        "at": { "type": "string" },
        "by": { "type": ["string", "null"] },
        "action": { "type": "string", "minLength": 1 },
        "transactionId": { "type": ["string", "null"], "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "oldValue": {},
        "newValue": {},
        "reason": { "type": ["string", "null"] },
        "versionBefore": { "type": ["integer", "null"], "minimum": 1 },
        "versionAfter": { "type": ["integer", "null"], "minimum": 1 },
        "version": { "type": ["integer", "null"], "minimum": 1 },
        "code": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "previousVerification": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "verifiedAt": { "type": ["string", "null"] },
            "verifiedBy": { "type": ["string", "null"] },
            "datasetVersion": { "type": ["string", "null"] }
          }
        }
      }
    },
    "auditResolution": {
      "type": "object",
      "required": [
        "code",
        "reason",
        "approvedBy",
        "approvedAt",
        "sourceReferenceId",
        "fieldsHash",
        "createdAt",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "minLength": 10 },
        "sourceReferenceId": { "type": "string", "minLength": 1 },
        "fieldsHash": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "minLength": 10 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "food": {
      "type": "object",
      "required": [
        "id",
        "displayCategory",
        "calculationGroup",
        "names",
        "portion",
        "nutrients",
        "status",
        "version",
        "source",
        "legacySource",
        "verification",
        "classificationStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "legacySectionKey": { "type": ["string", "null"] },
        "legacyIndex": { "type": ["integer", "null"], "minimum": 0 },
        "displayCategory": {
          "enum": [
            "noix_graines",
            "matieres_grasses",
            "legumes",
            "fruits",
            "poissons_fruits_mer",
            "viandes_volaille",
            "autres_sources_proteinees",
            "feculents",
            "produits_laitiers"
          ]
        },
        "calculationGroup": {
          "enum": ["protein", "starch", "vegetable", "fruit", "dairy", "fat", "whey"]
        },
        "exchangeProfileId": { "type": ["string", "null"] },
        "classificationStatus": {
          "enum": ["pending", "approved", "rejected"]
        },
        "names": {
          "type": "object",
          "required": ["fr", "en"],
          "additionalProperties": false,
          "properties": {
            "fr": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        },
        "portion": {
          "type": "object",
          "required": ["labelFr", "labelEn", "amount", "unit"],
          "additionalProperties": false,
          "properties": {
            "labelFr": { "type": "string", "minLength": 1 },
            "labelEn": { "type": "string", "minLength": 1 },
            "amount": { "type": "number", "exclusiveMinimum": 0 },
            "unit": {
              "enum": ["bottle", "slice", "piece", "count", "cup", "tbsp", "tsp", "ml", "g", "oz", "scoop", "portion"]
            },
            "grams": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "preparationState": {
              "anyOf": [
                { "type": "null" },
                {
                  "enum": [
                    "raw",
                    "cooked",
                    "drained",
                    "prepared",
                    "frozen",
                    "canned",
                    "dry_uncooked",
                    "ready_to_eat",
                    "not_applicable",
                    "unknown"
                  ]
                }
              ]
            },
            "brandSpecific": { "type": "boolean" },
            "brand": { "type": ["string", "null"] }
          }
        },
        "nutrients": {
          "type": "object",
          "required": ["proteinG", "carbsG", "declaredKcal"],
          "additionalProperties": false,
          "properties": {
            "proteinG": { "$ref": "#/$defs/nutrient" },
            "carbsG": { "$ref": "#/$defs/nutrient" },
            "fiberG": { "$ref": "#/$defs/nutrient" },
            "fatG": { "$ref": "#/$defs/nutrient" },
            "saturatedFatG": { "$ref": "#/$defs/nutrient" },
            "polyunsaturatedFatG": { "$ref": "#/$defs/nutrient" },
            "monounsaturatedFatG": { "$ref": "#/$defs/nutrient" },
            "declaredKcal": { "$ref": "#/$defs/nutrient" }
          }
        },
        "legacySource": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "reference": { "type": ["string", "null"] },
            "referenceId": { "type": ["string", "null"] },
            "notes": { "type": ["string", "null"] }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "anyOf": [
                { "type": "null" },
                {
                  "enum": [
                    "canadian_nutrient_file",
                    "usda_fooddata_central",
                    "manufacturer_label",
                    "manufacturer_website",
                    "peer_reviewed_reference",
                    "other_authoritative"
                  ]
                }
              ]
            },
            "name": { "type": ["string", "null"] },
            "recordId": { "type": ["string", "null"] },
            "url": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "#/$defs/httpUrl" }
              ]
            },
            "doi": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "#/$defs/doi" }
              ]
            },
            "accessedAt": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "#/$defs/isoDate" }
              ]
            },
            "servingDescription": { "type": ["string", "null"] },
            "nutrientsBasis": {
              "anyOf": [
                { "type": "null" },
                {
                  "enum": [
                    "as_consumed",
                    "as_purchased",
                    "dry",
                    "cooked",
                    "label_serving",
                    "unknown"
                  ]
                }
              ]
            },
            "notes": { "type": ["string", "null"] },
            "brand": { "type": ["string", "null"] },
            "productName": { "type": ["string", "null"] },
            "labelServingSize": { "type": ["string", "null"] },
            "evidenceRef": { "type": ["string", "null"] }
          }
        },
        "status": { "enum": ["unverified", "verified", "rejected"] },
        "version": { "type": "integer", "minimum": 1 },
        "verification": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["unverified", "verified", "rejected"] },
            "verifiedAt": { "type": ["string", "null"] },
            "verifiedBy": { "type": ["string", "null"] },
            "datasetVersion": { "type": ["string", "null"] }
          }
        },
        "auditResolutions": {
          "type": "array",
          "items": { "$ref": "#/$defs/auditResolution" }
        },
        "history": {
          "type": "array",
          "items": { "$ref": "#/$defs/historyEntry" }
        }
      },
      "if": {
        "properties": {
          "verification": {
            "properties": { "status": { "const": "verified" } },
            "required": ["status"]
          }
        },
        "required": ["verification"]
      },
      "then": {
        "properties": {
          "status": { "const": "verified" },
          "verification": {
            "type": "object",
            "required": ["status", "verifiedAt", "verifiedBy", "datasetVersion"],
            "additionalProperties": false,
            "properties": {
              "status": { "const": "verified" },
              "verifiedAt": { "type": "string", "minLength": 10 },
              "verifiedBy": { "type": "string", "minLength": 2 },
              "datasetVersion": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "else": {
        "properties": {
          "verification": {
            "type": "object",
            "required": ["status"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["unverified", "rejected"] },
              "verifiedAt": { "type": "null" },
              "verifiedBy": { "type": "null" },
              "datasetVersion": { "type": "null" }
            }
          }
        }
      }
    }
  }
}
